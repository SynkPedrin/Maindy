{
  "name": "@maindy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/main.ts",
    "start": "node --env-file-if-exists=../../.env.local dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "test:db": "vitest run test/e2e -t \"isolation\"",
    "test:e2e": "vitest run test/e2e",
    "serve": "tsx --env-file-if-exists=../../.env.local src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@huggingface/transformers": "^4.3.2",
    "@maindy/core": "workspace:^",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
