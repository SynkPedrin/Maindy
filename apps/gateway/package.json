{
  "name": "@maindy/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@maindy/contracts": "workspace:^",
    "@maindy/orbit-engine": "workspace:^",
    "@maindy/provider-adapters": "workspace:^",
