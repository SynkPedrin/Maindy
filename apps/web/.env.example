# Copie para .env.local. Nunca commite .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (lista de espera). Nunca use NEXT_PUBLIC_ aqui.
SUPABASE_SERVICE_ROLE_KEY=
# URL do sistema MAINDY que recebe a sessão após login/cadastro.
NEXT_PUBLIC_MAINDY_APP_URL=http://localhost:8081
# Versão vigente dos Termos e da Política de Privacidade (consentimento LGPD).
MAINDY_POLICY_VERSION=2026-11-12
