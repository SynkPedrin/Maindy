<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Floating agent: "Display over other apps". Granted only by the user in system settings
       (Settings.ACTION_MANAGE_OVERLAY_PERMISSION). Nothing in this module bypasses that. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <!-- Foreground service that owns the overlay window (Android 14+ requires a declared type). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

  <!-- Android 13+: needed for the persistent "MAINDY ativa" notification (with the "Remover"
       action) to be visible. Must still be requested at runtime by the JS app. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- Usage access. This is a special-access permission: declaring it does nothing by itself;
       the user must enable "Usage access" for MAINDY in system settings. -->
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />

  <application>

    <service
      android:name="com.maindy.nativemodule.floating.FloatingAgentService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="User-enabled floating assistant bubble drawn over other apps (SYSTEM_ALERT_WINDOW). Tapping it opens the MAINDY assistant; the user can remove it at any time from the notification or by dragging it to the dismiss target." />
    </service>

    <!-- Only bound by the system after the user grants "Notification access" to MAINDY. -->
    <service
      android:name="com.maindy.nativemodule.notifications.MaindyNotificationListenerService"
      android:exported="true"
      android:label="@string/maindy_notification_listener_label"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

  </application>
</manifest>
