{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "maindy",
  "version": "0.1.0",
  "identifier": "ai.maindy.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "maindy.",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#050417"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Eficiência de IA com o ORBIT Engine",
    "longDescription": "maindy. mede e otimiza o uso de IA (tokens, custo e qualidade) com o ORBIT Engine. Launcher no notch do Mac, pílula no Windows, painel completo e gateway local.",
    "copyright": "© 2026 maindy.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 380
        }
      },
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ]
      },
      "wix": {
        "language": [
          "pt-BR",
          "en-US"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["maindy"]
      }
    },
    "updater": {
      "endpoints": [
        "https://releases.maindy.invalid/desktop/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_MINISIGN_PUBLIC_KEY_WHEN_SIGNING_KEYS_EXIST"
    }
  }
}
