<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The bundled gateway is a Node.js single executable (V8). Under the hardened runtime V8
       needs JIT + writable-executable memory, otherwise it aborts at startup with
       "Failed to reserve virtual memory for CodeRange". No other exceptions are requested. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
