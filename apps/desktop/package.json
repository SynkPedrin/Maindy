{
  "name": "@maindy/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 1421 --strictPort",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "bundle": "node scripts/bundle.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "snapshots": "node scripts/snapshots.mjs"
  },
  "dependencies": {
    "@maindy/contracts": "workspace:^",
    "@maindy/design-system": "workspace:^",
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.74.0",
    "react": "19",
    "react-dom": "19"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.8.0",
    "vite": "^8.3.8"
  }
}
