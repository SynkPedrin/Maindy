# Copie para supabase/.env (fora do git) e preencha. Depois mude enabled = true no config.toml e reinicie o Supabase.
# Callback a cadastrar nos dois provedores: http://localhost:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
