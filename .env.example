# Copy to .env.local (git-ignored) and fill in. SERVER-SIDE SECRETS ONLY:
# nothing in this file may be shipped inside the mobile app.

# Supabase (local: `pnpm exec supabase status`)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# Storage root for the per-user Obsidian vaults (never a vault itself)
MAINDY_STORAGE_ROOT=
# 32 random bytes as 64 hex chars (encrypts OAuth tokens): openssl rand -hex 32
MAINDY_CREDENTIALS_KEY=
API_PORT=4000
API_HOST=0.0.0.0
PUBLIC_API_URL=
CORS_ORIGINS=http://localhost:8081,http://localhost:3100

# AI (Claude). Empty = the agent runs in OFFLINE mode (deterministic local engine).
ANTHROPIC_API_KEY=
MAINDY_MODEL=claude-opus-5-5
MAINDY_MODEL_FAST=claude-haiku-5-5
MAINDY_AI_TIMEOUT_MS=60000
MAINDY_AI_MAX_RETRIES=2

# Voice providers (VoiceStudio runs locally; the others are optional cloud providers)
VOICESTUDIO_URL=http://127.0.0.1:3900
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
EMBEDDINGS_PROVIDER=local

# Google OAuth (Gmail + Calendar), optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Master (super admin) user created by `pnpm master:create`
MASTER_EMAIL=
MASTER_PASSWORD=
