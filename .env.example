# MAINDY — variáveis de ambiente. Copie para .env (git-ignored).
# Nada daqui vai para o app desktop ou para o navegador, exceto variáveis NEXT_PUBLIC_*.

# --- Control plane (apps/api) ---
NODE_ENV=development
API_PORT=4100
API_PUBLIC_URL=http://localhost:4100
WEB_PUBLIC_URL=http://localhost:3100
DATABASE_URL=postgres://maindy:maindy_dev@127.0.0.1:5433/maindy
TEST_DATABASE_URL=postgres://maindy:maindy_dev@127.0.0.1:5433/maindy_test
# 32 bytes hex: openssl rand -hex 32
SESSION_SECRET=
# IP do cliente: em produção, defina o cabeçalho AUTORITATIVO da sua borda
# (Vercel: x-vercel-forwarded-for · Cloudflare: cf-connecting-ip · nginx: x-real-ip).
# Sem ele, o X-Forwarded-For repassado pelo Next pode ser falsificado.
TRUST_PROXY=loopback
CLIENT_IP_HEADER=
# E-mail (dev: Mailpit em http://localhost:8025)
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="maindy. <nao-responda@maindy.local>"
# Billing: "sandbox" (simulado, rotulado) ou "stripe"
BILLING_PROVIDER=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Downloads: diretório/URL base de releases reais
RELEASES_BASE_URL=http://localhost:4100/releases

# --- Web (apps/web) ---
API_INTERNAL_URL=http://127.0.0.1:4100
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- Gateway local (apps/gateway) ---
GATEWAY_PORT=8787
GATEWAY_API_URL=http://localhost:4100
# Upstreams BYOK (opcionais; podem vir do Keychain via app desktop)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
