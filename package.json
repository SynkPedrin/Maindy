{
  "name": "maindy",
  "private": true,
  "version": "0.1.0",
  "description": "MAINDY — assistente pessoal com IA e segundo cérebro",
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:api": "pnpm --filter @maindy/api dev",
    "dev:mobile": "pnpm --filter @maindy/mobile start",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "test:db": "pnpm --filter @maindy/api test:db",
    "test:e2e": "pnpm --filter @maindy/api test:e2e",
    "dev:setup": "node scripts/dev-setup.mjs",
    "master:create": "node scripts/create-master-user.mjs"
  },
  "devDependencies": {
    "supabase": "2.122.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3"
  }
}
